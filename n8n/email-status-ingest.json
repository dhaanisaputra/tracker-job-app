          "q": "from:(jobstreet.co.id OR jobstreet.com OR glints.com OR linkedin.com OR dealls.com)"
        }
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Gmail Trigger",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all();\nconst first = (items[0] && items[0].json) || {};\nconst rawFrom = first.from?.value?.[0]?.address\n  ?? first.from?.value\n  ?? first.from?.address\n  ?? first.from\n  ?? '';\nconst sender = typeof rawFrom === 'string' ? rawFrom : JSON.stringify(rawFrom);\nconst subject = first.subject ?? first.headers?.subject ?? '';\nconst body = first.text ?? first.textPlain ?? first.snippet ?? first.body ?? '';\nreturn [{ json: { sender, subject, body: String(body).slice(0, 4000) } }];"
      },
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Code Normalize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "text": "={{ $json.body }}",
        "schemaType": "fromJson",
        "inputSchema": "{\"type\":\"object\",\"properties\":{\"company\":{\"type\":\"string\"},\"role\":{\"type\":\"string\"},\"portal_status\":{\"type\":\"string\"},\"job_url\":{\"type\":\"string\"}},\"required\":[\"company\",\"role\",\"portal_status\"]}",
        "systemPrompt": "Ekstrak dari email notifikasi lamaran kerja. portal_status = status mentah sesuai teks email (contoh: 'Lamaran Dilihat', 'Shortlisted', 'Interview Invitation'). job_url = tautan loker bila ada, else ''."
      },
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "ParseEmail",
      "type": "@n8n/n8n-nodes-langchain.informationExtractor",
      "typeVersion": 1,
      "position": [680, 300]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const raw = $input.first().json; const parsed = raw.output ?? raw;\nconst norm = $('Code Normalize').first().json;\nconst portal = String(parsed.portal_status ?? '');\nconst sender = String(norm.sender ?? '').toLowerCase();\nconst lower = portal.toLowerCase();\nconst has = (...keys) => keys.some((k) => lower.includes(k));\nlet status = null;\nif (has('dilihat', 'viewed', 'seen')) status = 'Screening';\nelse if (has('diproses', 'in review', 'shortlisted', 'shortlist')) status = 'Screening';\nelse if (has('interview', 'diundang', 'wawancara')) status = 'HR Interview';\nelse if (has('offer', 'offering')) status = 'Offer';\nelse if (has('diterima', 'accepted', 'hired')) status = 'Accepted';\nelse if (has('kedaluwarsa', 'kadaluwarsa', 'expired', 'tidak lagi menerima')) status = 'Ghosted';\nelse if (has('ditolak', 'rejected', 'maaf')) status = 'Rejected';\nelse if (has('dibatalkan', 'withdrawn')) status = 'Withdrawn';\nlet source = 'Website Perusahaan';\nif (sender.includes('jobstreet')) source = 'JobStreet';\nelse if (sender.includes('glints')) source = 'Glints';\nelse if (sender.includes('linkedin')) source = 'LinkedIn';\nelse if (sender.includes('dealls')) source = 'Dealls';\nreturn [{ json: { company: parsed.company ?? '', role: parsed.role ?? '', status, portal_status: portal, source, job_url: parsed.job_url ?? '', notes: norm.subject ?? '' } }];"
      },
