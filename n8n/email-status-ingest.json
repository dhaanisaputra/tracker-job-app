{
  "id": "b7e4f2a1-8c3d-4e5f-9a6b-1c2d3e4f5a6b",
  "name": "email-status-ingest",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute",
              "value": 10
            }
          ]
        },
